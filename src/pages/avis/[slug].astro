---
import BlocAvisClientsVerifies from '../../components/BlocAvisClientsVerifies.astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { slugify } from '../../utils/slugify';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BoutonAmazon from '../../components/BoutonAmazon.astro';
import StickyCTA from '../../components/StickyCTA.astro';
import CarteApercu from '../../components/CarteApercu.astro';

export async function getStaticPaths() {
  const produits = await getCollection('produits');
  return produits.map(produit => {
    console.log(`[DEBUG] Product Path Generated: /avis/${produit.id}/`);
    return {
      params: { slug: produit.id },
      props: { produit },
    };
  });
}

const { produit } = Astro.props;
const { Content } = await render(produit);

// Produits similaires (même catégorie, exclure le courant)
const tousProduits = await getCollection('produits');
const similaires = tousProduits
  .filter(p => p.id !== produit.id && p.data.categories.some(cat => produit.data.categories.includes(cat)))
  .slice(0, 3);

const title = produit.data.meta_title || `Avis ${produit.data.titre} : Tout savoir avant d'acheter`;
const description = produit.data.meta_description || produit.data.description_courte;

// JSON-LD Product & Review
const jsonLd = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": produit.data.titre,
  "image": [produit.data.image_url],
  "description": produit.data.description_courte,
  "brand": {
    "@type": "Brand",
    "name": "Amazon"
  },
  "review": {
    "@type": "Review",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": "5",
      "bestRating": "5"
    },
    "author": {
      "@type": "Organization",
      "name": "Meilleur Convertisseur Pur Sinus"
    },
    "reviewBody": produit.data.description_longue
  },
  "offers": {
    "@type": "Offer",
    "url": produit.data.lien_affiliation,
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "Amazon"
    }
  }
};
---

<Layout title={title} description={description}>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	
	<div class="container mx-auto px-4 py-8 pb-32 md:pb-12">
		<Breadcrumb items={[
			{ label: "Tous les avis", href: "/avis/" },
			{ label: produit.data.titre }
		]} />

		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
			<!-- Main Content Column -->
			<div class="lg:col-span-8">
				<header class="mb-10">
					<div class="flex flex-wrap gap-2 mb-6">
						{produit.data.categories.map(cat => (
							<a href={`/comparatifs/${slugify(cat)}/`} class="bg-blue-50 text-blue-600 hover:bg-blue-100 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider transition-colors">
								{cat}
							</a>
						))}
					</div>
					<h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6 leading-[1.1] tracking-tight">
						Avis {produit.data.titre}
					</h1>
					<div class="flex items-center text-slate-500 text-sm font-medium border-y border-slate-100 py-4 mb-8">
						<span class="flex items-center">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							Vérifié par nos experts
						</span>
						<span class="mx-4 text-slate-200">|</span>
						<span class="flex items-center">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							Lecture : 6 min
						</span>
					</div>
				</header>

				<!-- Mobile Only Product Image -->
				<div class="lg:hidden mb-8">
					<div class="aspect-square bg-white rounded-2xl overflow-hidden p-8 border border-slate-100 shadow-sm ring-1 ring-slate-900/5">
						<img 
							src={produit.data.image_url} 
							alt={`Photo du convertisseur ${produit.data.titre}`} 
							class="w-full h-full object-contain mix-blend-multiply"
							width="500"
							height="500"
						/>
					</div>
				</div>

				<!-- Verdict Summary Card -->
				<section class="bg-slate-900 rounded-2xl p-8 mb-12 text-white relative overflow-hidden shadow-xl">
					<div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full blur-3xl -mr-16 -mt-16"></div>
					<div class="relative z-10">
						<h2 class="text-blue-400 font-bold uppercase tracking-widest text-sm mb-4">L'avis de la rédaction</h2>
						<p class="text-xl md:text-2xl font-medium leading-relaxed mb-8 italic">
							"{produit.data.description_longue}"
						</p>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-8 border-t border-slate-800">
							<div class="flex items-start">
								<div class="bg-green-500/20 p-1 rounded-full mr-3 mt-1">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
									</svg>
								</div>
								<p class="text-slate-300 text-sm"><span class="text-white font-bold block mb-1">Idéal pour :</span> Les camping-cars, les appareils sensibles et le solaire.</p>
							</div>
							<div class="flex items-start">
								<div class="bg-orange-500/20 p-1 rounded-full mr-3 mt-1">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
									</svg>
								</div>
								<p class="text-slate-300 text-sm"><span class="text-white font-bold block mb-1">Point d'attention :</span> Vérifiez bien la section de câble lors de l'installation.</p>
							</div>
						</div>
					</div>
				</section>

				<!-- Article Body -->
				<div class="prose prose-slate prose-lg max-w-none 
					prose-headings:text-slate-900 prose-headings:font-extrabold prose-headings:tracking-tight
					prose-p:leading-relaxed prose-p:text-slate-600
					prose-li:text-slate-600
					prose-strong:text-slate-900 prose-strong:font-bold
					prose-img:rounded-2xl prose-img:shadow-lg
					prose-h2:text-3xl prose-h2:mt-12 prose-h2:pb-4 prose-h2:border-b prose-h2:border-slate-100">
					<Content />
				<BlocAvisClientsVerifies 
					avis={produit.data.avis_clients} 
					satisfaction={produit.data.satisfaction_globale} 
					lienAmazon={produit.data.lien_affiliation} 
				/>

				</div>
			</div>

			<!-- Sidebar / CTA Column -->
			<aside class="lg:col-span-4">
				<div class="sticky top-24 space-y-8">
					<!-- Product Card Sidebar -->
					<div class="bg-white rounded-2xl shadow-sm border border-slate-100 ring-1 ring-slate-900/5 p-6 overflow-hidden transition-all duration-300 hover:shadow-xl">
						<div class="aspect-square bg-slate-50 rounded-xl overflow-hidden p-6 mb-6 border border-slate-50 relative group">
							<img 
								src={produit.data.image_url} 
								alt={`Acheter ${produit.data.titre} sur Amazon`} 
								class="w-full h-full object-contain mix-blend-multiply transition-transform duration-500 group-hover:scale-110"
								width="300"
								height="300"
							/>
						</div>
						<h3 class="text-xl font-bold text-slate-900 mb-4">{produit.data.titre}</h3>
						<div class="flex items-center mb-6">
							<div class="flex text-orange-400 mr-2">
								{[...Array(5)].map(() => (
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-current" viewBox="0 0 20 20">
										<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
									</svg>
								))}
							</div>
							<span class="text-sm font-bold text-slate-500">Choix de la rédaction</span>
						</div>
						<BoutonAmazon href={produit.data.lien_affiliation} class="w-full py-4 text-lg !rounded-xl" />
						<p class="text-center text-[10px] text-slate-400 mt-4 uppercase tracking-widest font-bold">
							Prix et disponibilité sur Amazon
						</p>
					</div>

					<!-- Expert Bio or Trust Box -->
					<div class="bg-blue-600 rounded-2xl p-6 text-white">
						<div class="flex items-center mb-4">
							<div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center mr-4">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
								</svg>
							</div>
							<span class="font-bold">Notre Engagement</span>
						</div>
						<p class="text-sm text-blue-100 leading-relaxed">
							Nous testons rigoureusement chaque convertisseur pour garantir la sécurité de vos appareils sensibles. Nos recommandations sont indépendantes et basées sur des tests techniques réels.
						</p>
					</div>
				</div>
			</aside>
		</div>

		{similaires.length > 0 && (
			<section class="mt-24 pt-16 border-t border-slate-100">
				<div class="flex justify-between items-end mb-10">
					<div>
						<h2 class="text-3xl font-bold text-slate-900 mb-2">Autres alternatives intéressantes</h2>
						<p class="text-slate-500 font-medium">Des modèles similaires qui pourraient aussi vous convenir.</p>
					</div>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{similaires.map(p => (
						<CarteApercu produit={p} />
					))}
				</div>
			</section>
		)}
	</div>

	<StickyCTA href={produit.data.lien_affiliation} />
</Layout>
