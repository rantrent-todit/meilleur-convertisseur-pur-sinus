---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import CarteApercu from '../components/CarteApercu.astro';
import BoutonAmazon from '../components/BoutonAmazon.astro';
import BlocVerdictTop3 from '../components/BlocVerdictTop3.astro';
import TableauComparatif from '../components/TableauComparatif.astro';
import BadgeConfiance from '../components/BadgeConfiance.astro';
import { slugify } from '../utils/slugify';
import { siteConfig } from '../config/site.config';

const allProducts = await getCollection('produits');

// Sélection experte des 3 best-sellers en stock permanent sur Amazon France
const winnerProduct = allProducts.find(p => p.id === 'edecoa-1500w-pur-sinus') || allProducts[0];
const secondProduct = allProducts.find(p => p.id === 'green-cell-300w-pur-sinus') || allProducts[1];
const thirdProduct = allProducts.find(p => p.id === 'green-cell-3000w-pur-sinus') || allProducts[2];

const top3 = [winnerProduct, secondProduct, thirdProduct];
const autresProduits = allProducts.filter(p => !top3.some(t => t.id === p.id)).slice(0, 6);

// Extraction unique des catégories pour le maillage interne
const toutesCategories = [...new Set(allProducts.flatMap(p => p.data.categories))].sort();

// Mots-clés et métadonnées sanctuarisés (Top 3 Google)
const title = "Meilleur Convertisseur Pur Sinus : Comparatif, Avis et Guide d'Achat";
const description = "Trouvez le meilleur convertisseur pur sinus : comparatif 12V et 24V, tests complets et avis d'experts pour bien choisir votre onduleur solaire ou van.";
const siteUrl = siteConfig.siteDomain.replace(/\/$/, '');

// Données structurées Schema.org pour le référencement naturel (Rich Snippets & Google E-E-A-T)
const faqItems = [
  {
    q: "Quelle puissance choisir pour mon convertisseur pur sinus ?",
    r: "Faites la somme des watts de vos appareils que vous comptez utiliser en même temps, puis ajoutez une marge de sécurité de 20%. Pour les équipements avec moteur ou compresseur (réfrigérateur, pompe), vérifiez que la puissance de crête est au moins le double de la puissance nominale."
  },
  {
    q: "Est-ce que le pur sinus use plus rapidement la batterie ?",
    r: "Non, au contraire. Son rendement supérieur à 88% limite les pertes par échauffement thermique, ce qui préserve la capacité utile de vos batteries 12V sur le long terme."
  },
  {
    q: "Puis-je brancher une machine à café à dosettes sur mon convertisseur ?",
    r: "Oui, mais uniquement sur un modèle pur sinus délivrant 1500W ou 2000W minimum, car les éléments de chauffe et pompes haute pression exigent une puissance de pointe soutenue."
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "Meilleur Convertisseur Pur Sinus",
      "url": `${siteUrl}/`,
      "description": description,
      "inLanguage": "fr-FR",
      "publisher": {
        "@type": "Organization",
        "name": siteConfig.siteName,
        "url": `${siteUrl}/`,
        "logo": `${siteUrl}/favicon.svg`
      }
    },
    {
      "@type": "Organization",
      "name": siteConfig.siteName,
      "url": `${siteUrl}/`,
      "email": siteConfig.contactEmail,
      "logo": `${siteUrl}/favicon.svg`
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Accueil",
          "item": `${siteUrl}/`
        }
      ]
    },
    {
      "@type": "ItemList",
      "name": "Le Podium des Meilleurs Convertisseurs Pur Sinus",
      "description": "Sélection des 3 meilleurs modèles recommandés par la rédaction selon nos tests vérifiés et disponibilités Amazon.",
      "itemListElement": top3.map((p, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": p.data.titre,
        "url": `${siteUrl}/avis/${p.id}/`
      }))
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.r
        }
      }))
    }
  ]
};
---

<Layout title={title} description={description}>
	<!-- Injection des données structurées Schema.org dans le Head -->
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

	<!-- Hero Section Optimisée SEO (Piliers Top 3 préservés) -->
	<section class="relative bg-slate-900 overflow-hidden text-white py-16 md:py-24">
		<div class="absolute inset-0 overflow-hidden pointer-events-none">
			<div class="absolute -top-1/2 -left-1/2 w-full h-full bg-gradient-to-b from-blue-500/20 to-transparent rounded-full blur-3xl"></div>
			<div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-b from-orange-500/10 to-transparent rounded-full blur-3xl transform translate-x-1/3"></div>
		</div>
		<div class="container mx-auto px-4 text-center relative z-10">
			<span class="inline-block py-1.5 px-4 rounded-full bg-blue-500/15 border border-blue-400/30 text-blue-300 text-xs sm:text-sm font-bold tracking-wider mb-5 uppercase">
				⚡ Expertise en Énergie Nomade & Solaire
			</span>
			<h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold mb-6 leading-tight tracking-tight">
				Meilleur <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-300">Convertisseur Pur Sinus</span> : <br class="hidden md:block"/> Comparatif & Guide
			</h1>
			<p class="text-base sm:text-lg md:text-xl text-slate-300 mb-8 max-w-3xl mx-auto font-medium leading-relaxed">
				Ne risquez pas d'endommager vos appareils sensibles. Nous avons testé et sélectionné les <strong class="text-white font-bold">meilleurs convertisseurs pur sinus 12V 220V</strong> en stock vérifié pour votre van, camping-car, bateau ou installation solaire.
			</p>
			<div class="flex flex-col sm:flex-row justify-center gap-4">
				<a href="#podium" class="bg-gradient-to-r from-orange-500 to-amber-500 text-white shadow-lg hover:shadow-orange-500/30 hover:-translate-y-0.5 px-8 py-3.5 rounded-xl font-bold transition-all duration-300 text-center">
					🏆 Voir le Podium Top 3 Immédiat
				</a>
				<a href="#guide" class="bg-slate-800 text-white hover:bg-slate-700 px-8 py-3.5 rounded-xl font-bold border border-slate-700 transition-all duration-300 text-center">
					📖 Lire le Guide d'Achat Complet
				</a>
			</div>
		</div>
	</section>

	<div class="container mx-auto px-4">
		<!-- Section 1 : Podium Verdict Top 3 (Conversion Maximale) -->
		<div id="podium">
			<BlocVerdictTop3 
				produits={top3} 
				titre="Le Podium : Les 3 Meilleurs Convertisseurs Pur Sinus"
				sousTitre="Modèles vérifiés en stock officiel sur Amazon France avec onde sinusoïdale pure certifiée"
			/>
		</div>

		<!-- Section 2 : Tableau Comparatif Synthétique -->
		<div id="comparatif">
			<TableauComparatif 
				produits={top3} 
				titreSection="Tableau Récapitulatif : Comparaison Directe du Top 3"
				sousTitreSection="Caractéristiques techniques et vérification de disponibilité en temps réel"
			/>
		</div>

		<!-- Section 3 : Badges de Réassurance & Protocole d'Évaluation -->
		<BadgeConfiance titre="Notre Protocole d'Évaluation des Onduleurs Pur Sinus" />
	</div>

	<!-- Section 4 : Sélection Étendue des Experts (Grille Secondaire) -->
	<section class="py-16 bg-slate-50 border-t border-slate-200">
		<div class="container mx-auto px-4">
			<div class="flex flex-col md:flex-row justify-between items-center mb-10 gap-6">
				<div>
					<span class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-1 block">Catalogue Complet</span>
					<h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Autres Modèles Analysés par la Rédaction</h2>
					<p class="text-slate-600 text-sm mt-1">Consultez nos bancs d'essai complets sur l'ensemble des marques du marché.</p>
				</div>
				<a href="/avis/" class="bg-white border border-slate-300 px-6 py-2.5 rounded-xl text-sm font-bold text-slate-800 hover:bg-slate-100 hover:border-slate-400 transition-all shadow-xs">
					Voir tous nos tests détaillés &rarr;
				</a>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{autresProduits.map(produit => (
					<CarteApercu produit={produit} />
				))}
			</div>
		</div>
	</section>

	<!-- Section 5 : Guide d'Achat Long-Form (SEO Power Sanctuarisé) -->
	<section id="guide" class="py-20 bg-white">
		<div class="container mx-auto px-4 max-w-5xl">
			<header class="text-center mb-14">
				<span class="inline-block text-xs font-black uppercase tracking-wider text-blue-600 mb-2">Guide d'Expert</span>
				<h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 mb-4 leading-tight">
					Comment choisir le <span class="text-blue-600">meilleur convertisseur pur sinus</span> ?
				</h2>
				<div class="w-20 h-1 bg-orange-500 mx-auto rounded-full"></div>
			</header>

			<div class="prose prose-slate prose-lg max-w-none text-slate-600 leading-relaxed">
				<p class="text-lg sm:text-xl font-medium text-slate-800 bg-blue-50 p-6 rounded-2xl border-l-4 border-blue-600 mb-10">
					Investir dans un convertisseur 12v 220v est une étape cruciale pour votre autonomie électrique. Cependant, une erreur de dimensionnement peut s'avérer destructrice pour vos appareils. Ce guide vous explique pourquoi le <strong class="text-slate-900">pur sinus</strong> est la seule technologie viable pour vos équipements électroniques sensibles.
				</p>

				<h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-12 mb-6">1. Qu'est-ce qu'un convertisseur pur sinus ?</h3>
				<p>
					Un convertisseur pur sinus (ou onduleur à onde sinusoïdale pure) transforme le courant continu (DC) de vos batteries en courant alternatif (AC) de 220V/230V. Sa particularité est de générer une onde électrique d'une pureté absolue, identique voire supérieure en stabilité à celle fournie par le réseau électrique domestique traditionnel.
				</p>
				<p>
					À l'inverse, les modèles "pseudo sinus" ou "onde modifiée" créent une onde "en escalier" agressive qui génère des harmoniques parasites et peut provoquer une surchauffe destructrice sur les équipements munis de microprocesseurs, de cartes mères ou de moteurs électriques à induction.
				</p>

				<div class="my-10 grid grid-cols-1 md:grid-cols-2 gap-6">
					<div class="bg-slate-900 text-white p-6 sm:p-8 rounded-2xl">
						<h4 class="text-orange-400 font-bold mb-4 flex items-center text-lg">
							<svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
							Avantages du Pur Sinus
						</h4>
						<ul class="space-y-2.5 text-sm text-slate-300">
							<li class="flex items-start"><span class="text-orange-400 mr-2 font-bold">•</span> Compatibilité totale avec 100% des appareils électriques.</li>
							<li class="flex items-start"><span class="text-orange-400 mr-2 font-bold">•</span> Zéro bruit parasite sur les écrans vidéo ou enceintes audio.</li>
							<li class="flex items-start"><span class="text-orange-400 mr-2 font-bold">•</span> Rendement énergétique supérieur (dépassant 88-90%).</li>
							<li class="flex items-start"><span class="text-orange-400 mr-2 font-bold">•</span> Préservation de la durée de vie de vos batteries et appareils.</li>
						</ul>
					</div>
					<div class="bg-slate-50 p-6 sm:p-8 rounded-2xl border border-slate-200">
						<h4 class="text-slate-900 font-bold mb-4 flex items-center text-lg">
							<svg class="w-5 h-5 mr-2 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
							Attention au Pseudo Sinus (Onde Modifiée)
						</h4>
						<ul class="space-y-2.5 text-sm text-slate-600">
							<li class="flex items-start"><span class="text-red-500 mr-2 font-bold">!</span> Risque d'endommager les chargeurs d'ordinateurs portables.</li>
							<li class="flex items-start"><span class="text-red-500 mr-2 font-bold">!</span> Incompatible avec les machines à café, réfrigérateurs et outils.</li>
							<li class="flex items-start"><span class="text-red-500 mr-2 font-bold">!</span> Sifflements et bourdonnements très désagréables en fonctionnement.</li>
						</ul>
					</div>
				</div>

				<h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-12 mb-6">2. Les critères essentiels pour trouver le convertisseur idéal</h3>
				
				<h4 class="text-xl font-bold text-slate-900">A. Puissance Nominale vs Puissance de Crête</h4>
				<p>
					C'est le piège numéro un. La <strong>puissance nominale</strong> (Watts) correspond à ce que le convertisseur est capable de fournir en continu sur plusieurs heures. La <strong>puissance crête</strong> représente sa capacité à encaisser une surcharge brève (généralement le double de la puissance nominale) pendant quelques millisecondes, indispensable au démarrage d'un moteur électrique (réfrigérateur, pompe, meuleuse).
				</p>

				<h4 class="text-xl font-bold text-slate-900 mt-8">B. La Tension d'Entrée : 12V, 24V ou 48V ?</h4>
				<p>
					Le meilleur convertisseur pur sinus pour votre situation doit correspondre rigoureusement à la tension nominale de votre parc d'accumulateurs :
					<ul class="list-disc pl-6 space-y-1">
						<li><strong>12V :</strong> Le standard absolu pour les voitures, vans aménagés, camping-cars et fourgons.</li>
						<li><strong>24V :</strong> Recommandé pour les poids lourds, bateaux de plaisance et installations solaires moyennes.</li>
						<li><strong>48V :</strong> Idéal pour les habitations en site isolé afin de réduire l'ampérage sur les câbles de forte puissance.</li>
					</ul>
				</p>

				<h4 class="text-xl font-bold text-slate-900 mt-8">C. L'Arsenal de Sécurités Électroniques</h4>
				<p>
					Un équipement de qualité professionnelle doit impérativement disposer d'un pack de protections automatisées : coupure sur sous-tension (pour éviter de tuer vos batteries de service), alarme de surtension, fusible accessible contre les inversions de polarité et coupure thermique en cas de surchauffe interne.
				</p>

				<div class="mt-14 bg-gradient-to-r from-blue-700 to-indigo-800 rounded-3xl p-8 sm:p-10 text-white shadow-xl relative overflow-hidden">
					<div class="absolute -right-20 -bottom-20 w-64 h-64 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
					<h3 class="text-2xl font-black mb-3 relative z-10">Besoin d'un banc d'essai spécifique ?</h3>
					<p class="mb-6 text-blue-100 text-sm sm:text-base relative z-10 max-w-2xl leading-relaxed">
						Nos spécialistes analysent en continu les nouveaux modèles du marché selon notre protocole d'évaluation indépendant. Retrouvez tous nos verdicts techniques classés par marque et par puissance.
					</p>
					<a href="/avis/" class="inline-block bg-white text-blue-700 hover:bg-slate-50 px-8 py-3.5 rounded-xl font-bold shadow-md hover:shadow-lg transition-all relative z-10">
						Explorer tous nos avis vérifiés &rarr;
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Section 6 : Maillage Interne Catégories SEO (Piliers Sanctuarisés) -->
	<section class="py-16 bg-slate-950 text-white">
		<div class="container mx-auto px-4">
			<div class="text-center mb-8">
				<span class="text-xs font-bold uppercase tracking-[0.2em] text-blue-400 block mb-2">Silos Thématiques</span>
				<h2 class="text-2xl sm:text-3xl font-extrabold text-white">Nos Comparatifs par Catégorie Spécifique</h2>
			</div>
			<div class="flex flex-wrap justify-center gap-3 max-w-5xl mx-auto">
				{toutesCategories.map(cat => (
					<a 
						href={`/comparatifs/${slugify(cat)}/`} 
						class="bg-slate-900/90 border border-slate-800 hover:border-blue-500 hover:text-blue-400 px-5 py-3 rounded-xl text-xs sm:text-sm font-bold shadow-xs transition-all duration-200"
					>
						{cat}
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Section 7 : Foire Aux Questions SEO (Données Structurées FAQPage) -->
	<section class="py-20 bg-white border-t border-slate-200">
		<div class="container mx-auto px-4 max-w-4xl">
			<div class="text-center mb-12">
				<span class="text-xs font-black uppercase tracking-wider text-blue-600 block mb-2">Questions Fréquentes</span>
				<h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900">Foire aux questions sur les convertisseurs pur sinus</h2>
			</div>
			<div class="space-y-6">
				{faqItems.map(f => (
					<div class="p-6 bg-slate-50 border border-slate-200/80 rounded-2xl hover:border-slate-300 transition-colors">
						<h3 class="font-extrabold text-base sm:text-lg text-slate-900 mb-2 flex items-center gap-2">
							<span class="text-blue-600 font-black">?</span> {f.q}
						</h3>
						<p class="text-slate-600 text-sm sm:text-base leading-relaxed pl-5">
							{f.r}
						</p>
					</div>
				))}
			</div>
		</div>
	</section>
</Layout>
