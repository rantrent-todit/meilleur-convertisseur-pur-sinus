---
import Layout from '../layouts/Layout.astro';

const title = "Page introuvable - 404";
const description = "Oups ! La page que vous recherchez semble s'être égarée. Retrouvez votre chemin vers nos comparatifs de convertisseurs pur sinus.";
---

<Layout title={title} description={description}>
	<div class="container mx-auto px-4 py-20 text-center">
		<div class="max-w-2xl mx-auto bg-white p-12 rounded-3xl shadow-sm border border-slate-200">
			<div class="inline-flex items-center justify-center w-24 h-24 bg-red-50 text-red-500 rounded-full mb-8">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
				</svg>
			</div>
			<h1 class="text-4xl font-extrabold text-slate-900 mb-4 leading-tight">
				Signal perdu... Page 404
			</h1>
			<p class="text-lg text-slate-600 mb-10 leading-relaxed">
				Il semble que ce convertisseur ait eu un court-circuit. La page que vous cherchez n'existe plus ou a été déplacée.
			</p>
			<div class="flex flex-wrap justify-center gap-4">
				<a href="/" class="bg-blue-600 text-white px-8 py-3 rounded-3xl font-bold hover:bg-blue-700 transition-colors">
					Retour à l'accueil
				</a>
				<a href="/avis/" class="bg-slate-100 text-slate-700 px-8 py-3 rounded-3xl font-bold hover:bg-slate-200 transition-colors">
					Voir nos avis produits
				</a>
			</div>
		</div>
	</div>
</Layout>
