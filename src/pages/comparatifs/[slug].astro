---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { slugify } from '../../utils/slugify';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CarteApercu from '../../components/CarteApercu.astro';

export async function getStaticPaths() {
	const produits = await getCollection('produits');
	const categoriesNoms = [...new Set(produits.flatMap(p => p.data.categories))];
	
	const paths = categoriesNoms.map(nom => {
		const slug = slugify(nom);
		console.log(`[DEBUG] Category Path Generated: /comparatifs/${slug}/ (${nom})`);
		return {
			params: { slug },
			props: { nomCat: nom },
		};
	});

	return paths;
}

const { slug } = Astro.params;
const { nomCat } = Astro.props;

const produits = (await getCollection('produits'))
	.filter(p => p.data.categories.includes(nomCat))
	.slice(0, 10); // Top 10

const categoriesCollection = await getCollection('categories');
const content = categoriesCollection.find(c => c.id === slug || c.id === `${slug}.md`);

const rendered = content ? await render(content) : null;
const Content = rendered?.Content;

const title = content?.data.titre_seo || `Meilleur ${nomCat} : Comparatif et Top 10 des modèles`;
const description = content?.data.description_seo || content?.data.texte_presentation?.substring(0, 160) || `Découvrez notre sélection des meilleurs ${nomCat}. Comparatif complet et guide pour faire le bon choix au meilleur prix.`;

// JSON-LD FAQ
const faqJsonLd = content?.data.faq ? {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": content.data.faq.map(f => ({
		"@type": "Question",
		"name": f.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": f.reponse
		}
	}))
} : null;
---

<Layout title={title} description={description}>
	{faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
	
	<div class="container mx-auto px-4 py-8">
		<Breadcrumb items={[
			{ label: "Tous les comparatifs", href: "/comparatifs/" },
			{ label: nomCat }
		]} />

		<header class="mb-12">
			<h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-6 leading-tight">
				{title}
			</h1>
			{content?.data.texte_presentation && (
				<div class="prose prose-slate prose-lg max-w-none mb-10 text-slate-600">
					<p>{content.data.texte_presentation}</p>
				</div>
			)}
			{!content && (
				<p class="text-lg text-slate-600 max-w-3xl">
					Voici notre sélection rigoureuse des meilleurs modèles de la catégorie <strong>{nomCat}</strong>. Nous avons analysé les performances, la fiabilité et les retours utilisateurs pour vous proposer ce Top {produits.length}.
				</p>
			)}
		</header>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
			{produits.map((produit, index) => (
				<div class="relative mt-4">
					<div class="absolute -top-6 -left-4 w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-700 text-white rounded-xl flex items-center justify-center font-black text-xl z-10 shadow-lg border-4 border-slate-50 rotate-3">
						#{index + 1}
					</div>
					<CarteApercu produit={produit} />
				</div>
			))}
		</div>

		{Content && (
			<section class="mt-20 prose prose-slate prose-lg max-w-none bg-white p-8 md:p-12 rounded-2xl shadow-sm border border-slate-100 ring-1 ring-slate-900/5">
				<Content />
			</section>
		)}

		{content?.data.faq && (
			<section class="mt-20 py-16 bg-white rounded-2xl shadow-sm border border-slate-100 ring-1 ring-slate-900/5 p-8 md:p-12">
				<h2 class="text-3xl font-bold text-slate-900 mb-10 flex items-center">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600 mr-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
					</svg>
					Foire aux questions sur les {nomCat}
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
					{content.data.faq.map(f => (
						<div>
							<h3 class="text-lg font-bold text-slate-900 mb-3">{f.question}</h3>
							<p class="text-slate-600 leading-relaxed">{f.reponse}</p>
						</div>
					))}
				</div>
			</section>
		)}
	</div>
</Layout>
