---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { slugify } from '../../utils/slugify';
import { formatCategoryLabel } from '../../utils/formatCategory';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BlocVerdictTop3 from '../../components/BlocVerdictTop3.astro';
import BadgeConfiance from '../../components/BadgeConfiance.astro';

export async function getStaticPaths() {
	const produits = await getCollection('produits');
	const categoriesCollection = await getCollection('categories');
	const catsFromProds = produits.flatMap(p => p.data.categories);
	const catsFromCollection = categoriesCollection.map(c => c.id.replace(/\.md$/, ''));
	const categoriesNoms = [...new Set([...catsFromProds, ...catsFromCollection])];
	
	const paths = categoriesNoms.map(nom => {
		const slug = slugify(nom);
		console.log(`[DEBUG] Category Path Generated: /comparatifs/${slug}/ (${nom})`);
		return {
			params: { slug },
			props: { nomCat: nom },
		};
	});

	return paths;
}

const { slug } = Astro.params;
const { nomCat } = Astro.props;

const categoriesCollection = await getCollection('categories');
const content = categoriesCollection.find(c => c.id === slug || c.id === `${slug}.md`);

const rawProduits = (await getCollection('produits'))
	.filter(p => p.data.categories.includes(nomCat) || p.data.categories.includes(slug));

// Marques reconnues et marques de premier plan
const tier1Brands = ['Victron Energy', 'Victron', 'Renogy'];
const recognizedBrands = [
	'Victron Energy', 'Victron', 'Renogy', 'GIANDEL', 'EDECOA', 'Green Cell', 'DATOUBOSS', 'VEVOR', 'OLTEANP',
	'NOVOPAL', 'Novopal', 'SUDOKEJI', 'JARXIOKE', 'FEITEENG', 'PVBEYORND', 'TAGEEBLU', 'XWJNE', 'MINGHAOXIN'
];

function getBrandName(title: string, id: string): string {
	for (const b of recognizedBrands) {
		if (title.toLowerCase().includes(b.toLowerCase()) || id.toLowerCase().includes(b.toLowerCase())) {
			return b.startsWith('Victron') ? 'Victron' : b;
		}
	}
	return 'Générique';
}

// Algorithme de scoring de conversion Top 3 : Marque + Prix > 100€ + Volume Avis + Note
const produitsScored = rawProduits.map(p => {
	let score = 0;
	const title = p.data.titre;
	const brand = getBrandName(title, p.id);
	const isTier1 = tier1Brands.some(b => title.toLowerCase().includes(b.toLowerCase()) || p.id.toLowerCase().includes(b.toLowerCase()));
	const isBranded = brand !== 'Générique';
	
	// 1. Bonus Marque Tier-1 (+700 pts) ou Marque renommée (+500 pts)
	if (isTier1) {
		score += 700;
	} else if (isBranded) {
		score += 500;
	}
	
	// 2. Bonus Panier sérieux (> 100 € : +300 pts, gadget < 80 € : -150 pts)
	const prixNum = parseFloat((p.data.prix || '0').replace(',', '.'));
	if (prixNum >= 100) {
		score += 300;
	} else if (prixNum > 0 && prixNum < 80) {
		score -= 150;
	}

	// 3. Bonus Preuve Sociale (Volume total d'avis clients)
	const totalAvis = p.data.satisfaction_globale?.total_avis || 0;
	score += Math.min(Math.log10(Math.max(totalAvis, 1)) * 100, 350);

	// 4. Bonus Note de satisfaction client
	const note = p.data.satisfaction_globale?.note_moyenne || 4.0;
	score += (note - 4.0) * 200;

	return { produit: p, score, brand };
});

// Sélection intelligente du Top 3 : diversité des marques prioritaires
const sortedProds = [...produitsScored].sort((a, b) => b.score - a.score);
const selectedTop3: typeof sortedProds = [];
const seenBrands = new Set<string>();

for (const item of sortedProds) {
	if (selectedTop3.length >= 3) break;
	if (item.brand !== 'Générique' && !seenBrands.has(item.brand)) {
		selectedTop3.push(item);
		seenBrands.add(item.brand);
	}
}

for (const item of sortedProds) {
	if (selectedTop3.length >= 3) break;
	if (!selectedTop3.some(t => t.produit.id === item.produit.id)) {
		selectedTop3.push(item);
	}
}

const produits = selectedTop3.map(item => item.produit);

const rendered = content ? await render(content) : null;
const Content = rendered?.Content;

const title = content?.data.titre_seo || `Meilleur ${nomCat} : Comparatif et Top Modèles`;
const h1Title = content?.data.titre_h1 || title;
const catLabel = formatCategoryLabel(slug || nomCat);
const nomCatAffichage = catLabel;
const description = content?.data.description_seo || content?.data.texte_presentation?.substring(0, 160) || `Découvrez notre sélection des meilleurs ${nomCat}. Comparatif complet et guide pour faire le bon choix au meilleur prix.`;

// JSON-LD ItemList (Top 3)
const itemListJsonLd = produits.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "ItemList",
	"name": `Top 3 ${catLabel}`,
	"numberOfItems": produits.length,
	"itemListElement": produits.map((p, index) => ({
		"@type": "ListItem",
		"position": index + 1,
		"name": p.data.titre,
		"url": `https://meilleur-convertisseur-pur-sinus.fr/avis/${p.id}/`
	}))
} : null;

// JSON-LD FAQ
const faqJsonLd = content?.data.faq ? {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": content.data.faq.map(f => {
		const q = (f as any).question || (f as any).q || "";
		const r = (f as any).reponse || (f as any).r || "";
		return {
			"@type": "Question",
			"name": q,
			"acceptedAnswer": {
				"@type": "Answer",
				"text": r
			}
		};
	})
} : null;
---

<Layout title={title} description={description}>
	{itemListJsonLd && <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />}
	{faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
	
	<div class="container mx-auto px-4 py-8">
		<Breadcrumb items={[
			{ label: "Tous les comparatifs", href: "/comparatifs/" },
			{ label: nomCatAffichage }
		]} />

		<header class="mb-10 max-w-4xl">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-black uppercase tracking-wider mb-4">
				<svg class="w-3.5 h-3.5 text-blue-600" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
				</svg>
				Comparatif & Guide d'Achat Spécialisé
			</div>
			<h1 class="text-3xl md:text-5xl font-black text-slate-900 mb-6 leading-tight tracking-tight">
				{h1Title}
			</h1>
			{content?.data.texte_presentation && (
				<div class="prose prose-slate prose-lg max-w-none text-slate-600 leading-relaxed mb-6">
					<p>{content.data.texte_presentation}</p>
				</div>
			)}
			{!content && (
				<p class="text-lg text-slate-600 max-w-3xl leading-relaxed">
					Voici notre sélection rigoureuse des modèles les plus fiables de la catégorie <strong>{nomCatAffichage}</strong>. Nous avons analysé la stabilité de tension, le rendement et les retours d'expérience vérifiés pour vous guider.
				</p>
			)}
		</header>

		<!-- PODIUM TOP 3 DE CONVERSION EXCLUSIF -->
		{produits.length >= 2 && (
			<BlocVerdictTop3 
				produits={produits}
				sousTitre="Les 3 modèles incontournables sélectionnés pour leur fiabilité de marque, leur rendement et la satisfaction vérifiée"
			/>
		)}

		<!-- BADGE DE RÉASSURANCE / CONFIANCE -->
		<BadgeConfiance />

		<!-- GUIDE D'ACHAT COMPLET & CONTENU ÉDITORIAL -->
		{Content && (
			<section class="my-16 prose prose-slate prose-lg max-w-none bg-white p-8 md:p-12 rounded-3xl shadow-sm border border-slate-200/90 ring-1 ring-slate-900/5">
				<Content />
			</section>
		)}
	</div>
</Layout>
