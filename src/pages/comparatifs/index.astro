---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils/slugify';
import Breadcrumb from '../../components/Breadcrumb.astro';

const produits = await getCollection('produits');
const categoriesCollection = await getCollection('categories');

// Extraction unique des catégories depuis les produits et la collection categories
const categoriesNoms = [...new Set([...produits.flatMap(p => p.data.categories), ...categoriesCollection.map(c => c.id.replace(/\.md$/, ''))])].sort();

// Enrichissement avec les données de la collection categories si elles existent
const categoriesData = categoriesNoms.map(nom => {
	const slug = slugify(nom);
	const content = categoriesCollection.find(c => c.id === slug || c.id === `${slug}.md`);
	return {
		nom,
		slug,
		titre: content?.data.titre_h1 || content?.data.titre_seo || `Comparatif : Meilleur ${nom}`,
		description: content?.data.description_seo || content?.data.texte_presentation?.substring(0, 140),
		count: produits.filter(p => p.data.categories.includes(nom)).length
	};
});

const title = "Comparatifs Convertisseurs Pur Sinus par Catégorie";
const description = "Découvrez nos comparatifs détaillés par catégorie : puissance, tension (12V, 24V), usage spécifique. Trouvez le meilleur convertisseur pour votre projet.";
---

<Layout title={title} description={description}>
	<div class="container mx-auto px-4 py-8">
		<Breadcrumb items={[{ label: "Tous les comparatifs" }]} />

		<header class="mb-12">
			<h1 class="text-4xl font-extrabold text-slate-900 mb-4">
				Nos comparatifs de convertisseurs Pur Sinus
			</h1>
			<p class="text-lg text-slate-600 max-w-3xl">
				Sélectionnez une catégorie ci-dessous pour accéder au Top 10 des produits recommandés par nos experts selon vos besoins spécifiques.
			</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			{categoriesData.map(cat => (
				<a 
					href={`/comparatifs/${cat.slug}/`} 
					class="group bg-white p-8 rounded-3xl border border-slate-200 shadow-sm hover:border-blue-500 hover:shadow-md transition-all flex flex-col justify-between"
				>
					<div>
						<div class="inline-flex items-center justify-center w-12 h-12 bg-blue-50 text-blue-600 rounded-2xl mb-6 group-hover:bg-blue-600 group-hover:text-white transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
							</svg>
						</div>
						<h2 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-blue-600 transition-colors">
							{cat.titre}
						</h2>
						{cat.description && (
							<p class="text-slate-600 text-sm mb-3 line-clamp-2 leading-relaxed">
								{cat.description}
							</p>
						)}
						<p class="text-slate-500 text-xs font-semibold uppercase tracking-wider">
							{cat.count} modèle{cat.count > 1 ? 's' : ''} analysé{cat.count > 1 ? 's' : ''}
						</p>
					</div>
					<div class="mt-6 flex items-center text-blue-600 font-bold text-sm">
						Voir le comparatif
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7" />
						</svg>
					</div>
				</a>
			))}
		</div>

		{categoriesData.length === 0 && (
			<div class="text-center py-20 bg-slate-50 rounded-3xl border-2 border-dashed border-slate-200">
				<p class="text-slate-500 font-medium italic">Aucune catégorie détectée.</p>
			</div>
		)}
	</div>
</Layout>
