---
interface Props {
	items: {
		label: string;
		href?: string;
	}[];
}

const { items } = Astro.props;

// JSON-LD BreadcrumbList
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Accueil",
			"item": "https://meilleur-convertisseur-pur-sinus.fr/"
		},
		...items.map((item, index) => ({
			"@type": "ListItem",
			"position": index + 2,
			"name": item.label,
			...(item.href ? { "item": `https://meilleur-convertisseur-pur-sinus.fr${item.href}` } : {})
		}))
	]
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<nav aria-label="Breadcrumb" class="mb-8">
	<ol class="flex flex-wrap items-center text-sm text-slate-500 gap-2">
		<li class="flex items-center">
			<a href="/" class="hover:text-blue-600 transition-colors">Accueil</a>
		</li>
		{items.map((item, index) => (
			<li class="flex items-center min-w-0">
				<svg class="h-4 w-4 text-slate-300 mx-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
				</svg>
				{item.href && index < items.length - 1 ? (
					<a href={item.href} class="hover:text-blue-600 transition-colors truncate">
						{item.label}
					</a>
				) : (
					<span class="font-medium text-slate-900 truncate" aria-current="page">
						{item.label}
					</span>
				)}
			</li>
		))}
	</ol>
</nav>
