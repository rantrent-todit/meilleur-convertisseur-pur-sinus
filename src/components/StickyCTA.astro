---
import BoutonAmazon from './BoutonAmazon.astro';

interface Props {
	href: string;
}

const { href } = Astro.props;
---

<div class="md:hidden fixed bottom-0 left-0 right-0 p-4 bg-white/80 backdrop-blur-md border-t border-slate-200 z-50 shadow-2xl">
	<BoutonAmazon href={href} class="w-full shadow-lg" />
</div>
