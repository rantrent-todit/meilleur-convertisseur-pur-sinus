---
import BoutonAmazon from './BoutonAmazon.astro';

interface Props {
	produit: {
		id: string;
		data: {
			titre: string;
			description_courte: string;
			image_url: string;
			lien_affiliation: string;
		}
	};
}

const { produit } = Astro.props;
const slug = produit.id;
---

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden flex flex-col h-full transition-all duration-300 hover:shadow-xl hover:-translate-y-1 group ring-1 ring-slate-900/5">
	<a href={`/avis/${slug}/`} class="block relative aspect-video bg-gradient-to-b from-white to-slate-50 border-b border-slate-100 overflow-hidden">
		<img 
			src={produit.data.image_url} 
			alt={`Test & Avis du convertisseur ${produit.data.titre} - Pur Sinus`} 
			class="w-full h-full object-contain p-6 transition-transform duration-500 group-hover:scale-105 mix-blend-multiply"
			loading="lazy"
			width="400"
			height="225"
		/>
	</a>
	<div class="p-6 flex flex-col flex-grow">
		<h3 class="text-lg font-bold text-slate-900 mb-3 line-clamp-2 leading-snug">
			<a href={`/avis/${slug}/`} class="hover:text-blue-600 transition-colors">
				{produit.data.titre}
			</a>
		</h3>
		<p class="text-slate-500 text-sm mb-6 line-clamp-3 flex-grow leading-relaxed">
			{produit.data.description_courte}
		</p>
		<div class="space-y-3 pt-4 border-t border-slate-50 mt-auto">
			<BoutonAmazon href={produit.data.lien_affiliation} class="w-full py-2.5 text-sm !rounded-xl" />
			<a 
				href={`/avis/${slug}/`} 
				class="block text-center text-sm font-semibold text-slate-700 hover:text-blue-700 py-2.5 border border-slate-200 hover:border-blue-200 rounded-xl bg-white hover:bg-blue-50 transition-all duration-200"
			>
				Lire l'avis complet
			</a>
		</div>
	</div>
</div>
