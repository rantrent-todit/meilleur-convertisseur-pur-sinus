---
import BoutonAmazon from './BoutonAmazon.astro';

interface ProductItem {
  id: string;
  data: {
    titre: string;
    description_courte: string;
    image_url: string;
    lien_affiliation: string;
    categories: string[];
  };
}

interface Props {
  produits: ProductItem[];
  titreSection?: string;
  sousTitreSection?: string;
  limit?: number;
}

const { 
  produits = [], 
  titreSection = "Tableau Comparatif : Le Top de la Rédaction",
  sousTitreSection = "Comparaison directe des équipements les plus fiables selon nos tests vérifiés",
  limit = 3
} = Astro.props;

const effectiveLimit = Math.min(Math.max(limit, 1), 5);
const produitsAffiches = produits.slice(0, effectiveLimit);
const badgeSelection = "Top 3 Sélection";
---

<div class="my-12">
  <div class="text-center md:text-left mb-6">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-slate-900 text-white mb-2">
      {badgeSelection}
    </span>
    <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight !my-0">{titreSection}</h2>
    <p class="text-slate-600 text-sm mt-1">{sousTitreSection}</p>
  </div>

  <div class="w-full md:overflow-x-auto pb-4 table-scrollbar">
    <table class="w-full mx-auto block md:table md:min-w-[700px] border-collapse border-spacing-0 md:border-separate md:rounded-2xl md:border md:border-slate-200 bg-transparent md:bg-white shadow-none md:shadow-xs md:overflow-hidden text-left box-border">
      <thead class="hidden md:table-header-group">
        <tr class="hidden md:table-row bg-slate-50 border-b border-slate-200 text-slate-700 text-xs uppercase tracking-wider">
          <th class="hidden md:table-cell py-4 px-5 font-bold border-b border-slate-200 w-1/2">Modèle analysé</th>
          <th class="hidden md:table-cell py-4 px-4 font-bold border-b border-slate-200 text-center w-1/4">Verdict Rédaction</th>
          <th class="hidden md:table-cell py-4 px-4 font-bold border-b border-slate-200 text-center w-1/4">Offre vérifiée</th>
        </tr>
      </thead>
      <tbody class="w-full block space-y-4 md:space-y-0 md:table-row-group md:divide-y md:divide-slate-100 text-sm">
        {produitsAffiches.map((p, idx) => {
          const isWinner = idx === 0;
          const isSecond = idx === 1;
          const isThird = idx === 2;
          const badgeText = isWinner ? "🏆 N°1 Choix Global" : (isSecond ? "⭐ N°2 Rapport Qualité/Prix" : "⚡ N°3 Haut de Gamme");
          const badgeClass = isWinner ? "bg-blue-100 text-blue-800 font-black" : (isSecond ? "bg-amber-100 text-amber-800 font-bold" : "bg-purple-100 text-purple-800 font-bold");

          return (
            <tr class="block md:table-row rounded-2xl md:rounded-none border border-slate-200 md:border-none p-4 md:p-0 bg-white shadow-xs md:shadow-none mb-4 md:mb-0">
              <td class="block md:table-cell py-2 md:py-4 px-2 md:px-5">
                <div class="flex items-center gap-4">
                  <div class="w-16 h-16 shrink-0 bg-slate-50 rounded-xl p-2 border border-slate-100 flex items-center justify-center">
                    <img src={p.data.image_url} alt={p.data.titre} class="max-h-full max-w-full object-contain mix-blend-multiply" loading="lazy" />
                  </div>
                  <div>
                    <span class={`inline-block text-[11px] uppercase tracking-wider px-2 py-0.5 rounded-full mb-1 ${badgeClass}`}>
                      {badgeText}
                    </span>
                    <h3 class="font-extrabold text-slate-900 text-base leading-tight">
                      <a href={`/avis/${p.id}/`} class="hover:text-blue-600 transition-colors">
                        {p.data.titre}
                      </a>
                    </h3>
                  </div>
                </div>
              </td>
              <td class="block md:table-cell py-2 md:py-4 px-2 md:px-4 text-left md:text-center">
                <span class="inline-flex items-center gap-1 text-emerald-600 font-black text-xs md:text-sm bg-emerald-50 px-2.5 py-1 rounded-full">
                  ✓ Recommandé par l'expert
                </span>
              </td>
              <td class="block md:table-cell py-3 md:py-4 px-2 md:px-4 text-left md:text-center">
                <BoutonAmazon 
                  href={p.data.lien_affiliation}
                  texte="Vérifier le stock"
                  sousTexte="Amazon.fr vérifié"
                  variant={isWinner ? "winner" : "compact"}
                  class="w-full md:w-auto"
                />
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>
